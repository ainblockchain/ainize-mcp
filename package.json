{
  "name": "@ainize/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client-lib.d.ts",
      "import": "./dist/client-lib.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "import": "./dist/money.js"
    }
  },
  "bin": {
    "ainize-mcp": "./dist/bin.js",
    "ainize-subgraph-to-training-set": "./dist/examples/subgraph-to-training-set.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/bin.ts",
    "start": "node dist/bin.js",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@ainize/core": "0.1.0",
    "express": "^5.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@ainize/node": "0.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "tsx": "^4.23.13"
  },
  "description": "ainize-mcp — Ainize as an MCP server: search knowledge, prove it with a before/after live test, quote and buy it over x402, from Claude Code / Cursor / ChatGPT"
}
