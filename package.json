{
  "name": "@ainize/mcp",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24" },
  "description": "ainize-mcp — Ainize as an MCP server: search knowledge, prove it with a before/after live test, quote and buy it over x402, from Claude Code / Cursor / ChatGPT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client-lib.d.ts",
      "import": "./dist/client-lib.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "import": "./dist/money.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "ainize-mcp": "./dist/bin.js",
    "ainize-subgraph-to-training-set": "./dist/examples/subgraph-to-training-set.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/bin.ts",
    "start": "node dist/bin.js",
    "test": "node --test --import tsx test/*.test.ts",
    "demo:graph": "bash scripts/demo-graph.sh",
    "validate:graph": "node scripts/validate-graph-evidence.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@ainize/core": "git+https://github.com/ainblockchain/ainize-core.git#fafaa517efc37716cd79b1344b97c7f7cc096e58",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@ainize/node": "git+https://github.com/ainblockchain/ainize-node.git#cb761f82f1c95cc861c3d3d54b46612dd7938884",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
